# Production, read by docker-compose.production.yml:
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d --build
# configure.sh writes this file for you.

# Previews are served under this domain; it needs a DNS record
# *.preview.yourdomain.com pointing to the server. The dashboard is
# https://spawner.preview.yourdomain.com
SPAWNER_PREVIEW_DOMAIN=preview.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

SPAWNER_DATA_DIR=/opt/spawner
# Bearer token of the installation (every scope, no user), for scripts and
# CI. Generate one with: openssl rand -hex 24
SPAWNER_BOOTSTRAP_TOKEN=GENERATE_WITH_openssl_rand_hex_24

DB_NAME=spawner
DB_USER=spawner
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Optional: GitHub login, also configurable from the settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
GITHUB_TEAM=

SESSION_SECRET=GENERATE_NEW_SECRET_WITH_openssl_rand_base64_32
SESSION_MAX_AGE=86400000
