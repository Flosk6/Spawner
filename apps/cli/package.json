{
  "name": "@spawner/cli",
  "version": "2.0.0",
  "private": true,
  "description": "Spawner CLI and MCP server: preview environments from a worktree or a branch",
  "type": "module",
  "bin": {
    "spawner": "./dist/spawner.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@spawner/core": "workspace:*",
    "@spawner/types": "workspace:*",
    "@spawner/utils": "workspace:*",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "commander": "^14.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "socket.io-client": "^4.8.4",
    "tar": "^7.5.22",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
