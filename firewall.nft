#!/usr/sbin/nft -f
#
# Spawner's rules for the containers of Docker's bridge networks: the
# environments, the containers of their builds and Spawner's own stack. They
# hold what these containers send, in a table of their own that Docker, ufw
# and firewalld leave alone:
#   - the metadata services of the clouds (169.254.0.0/16, Azure's
#     168.63.129.16, Alibaba's 100.100.100.200) are refused, but for DNS,
#     which some clouds answer there: the code of a branch must not read the
#     credentials of the server;
#   - the host itself answers on DNS, HTTP and HTTPS only (the URLs of the
#     previews), not on SSH or the other services listening on it. Published
#     ports stay reachable: Docker forwards them as it forwards the internet.
# The rest of the internet, and of the private networks, stays reachable.
#
# The spawner-firewall container loads this file, then again every minute,
# and a drop-in of docker.service loads it before Docker starts, so that no
# container runs without it after a reboot. Loading it replaces the table in
# one transaction.

table inet spawner
delete table inet spawner

table inet spawner {
  set metadata {
    type ipv4_addr
    flags interval
    elements = { 169.254.0.0/16, 168.63.129.16, 100.100.100.200 }
  }

  chain from_containers {
    ip daddr @metadata meta l4proto { tcp, udp } th dport 53 return
    ip daddr @metadata reject
    ip6 daddr fd00:ec2::254 reject
  }

  chain to_host {
    ct state established,related return
    meta l4proto { tcp, udp } th dport 53 return
    tcp dport { 80, 443 } return
    reject
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "br-*" jump from_containers
    iifname "docker0" jump from_containers
  }

  chain input {
    type filter hook input priority filter; policy accept;
    iifname "br-*" jump to_host
    iifname "docker0" jump to_host
  }
}
