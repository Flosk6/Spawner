# Local development. Copy to .env: docker compose (docker-compose.yml) and
# the API started with pnpm dev both read it.

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=spawner
DB_PASSWORD=spawner
DB_NAME=spawner

# Engine: sources, rendered compose files, routes, job logs and deploy keys
# live under SPAWNER_DATA_DIR. Use an absolute path: it is mounted at the
# same path in the Spawner container.
SPAWNER_DATA_DIR=/absolute/path/to/spawner/local-data/dev
# Every subdomain of localtest.me resolves to 127.0.0.1.
SPAWNER_PREVIEW_DOMAIN=localtest.me
# Port Traefik listens on for the previews and the dashboard.
SPAWNER_HTTP_PORT=80
# Memory of the Spawner container (docker compose only).
SPAWNER_MEMORY_LIMIT=1g
# Bearer token of the installation (every scope, no user), for scripts and
# CI. Generate one with: openssl rand -hex 24
SPAWNER_BOOTSTRAP_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock

# Optional: the master secret (signing and encryption keys derive from it).
# Without it, Spawner generates one into SPAWNER_DATA_DIR/secret.key.
# SPAWNER_SECRET=

# Optional: GitHub login, also configurable from the settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
GITHUB_TEAM=

SESSION_MAX_AGE=86400000

# The dashboard; a host of the preview domain, so it can hand out preview cookies.
FRONTEND_URL=http://spawner.localtest.me

# Where the Vite dev server (pnpm dev, port 8080) forwards /api and the terminal.
VITE_API_URL=http://localhost:3000
