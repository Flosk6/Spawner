# Local development. Copy to .env: docker compose (docker-compose.yml) and
# the API started with pnpm dev both read it.

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=spawner
DB_PASSWORD=spawner
DB_NAME=spawner

# Engine: sources, rendered compose files, routes, job logs and deploy keys
# live under SPAWNER_DATA_DIR. Use an absolute path: it is mounted at the
# same path in the Spawner container.
SPAWNER_DATA_DIR=/absolute/path/to/spawner/local-data/dev
# Every subdomain of localtest.me resolves to 127.0.0.1.
SPAWNER_PREVIEW_DOMAIN=localtest.me
# Port Traefik listens on for the previews and the dashboard.
SPAWNER_HTTP_PORT=80
# Bearer token accepted by /api/v1 for scripts and the CLI until personal
# tokens exist. Generate one with: openssl rand -hex 24
SPAWNER_BOOTSTRAP_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock

# GitHub OAuth (dashboard login)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://spawner.localtest.me/api/auth/github/callback
GITHUB_ORG=your_github_org_name
GITHUB_TEAM=your_team_slug

SESSION_SECRET=GENERATE_WITH_openssl_rand_base64_32
SESSION_MAX_AGE=86400000

FRONTEND_URL=http://spawner.localtest.me

# Where the Vite dev server (pnpm dev, port 8080) forwards /api and the terminal.
VITE_API_URL=http://localhost:3000
